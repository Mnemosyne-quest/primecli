# primecli — environment template.
# Copy to .env, fill in your key, and source it (or paste into your shell rc).

# DeltaPrime (Avalanche C-chain).
export DELTAPRIME_PRIVATE_KEY="0x..."
# Override the default public RPC with a paid endpoint for higher throughput:
# export DELTAPRIME_RPC="https://avalanche-mainnet.g.alchemy.com/v2/YOUR-KEY"

# Alternative: keep the key in a file (chmod 600) and point at it instead.
# The file should contain ONLY the raw 0x... key, nothing else.
# export DELTAPRIME_KEY_FILE="/path/to/.deltaprime-key"

# DegenPrime (Base). Falls back to DELTAPRIME_PRIVATE_KEY / DELTAPRIME_KEY_FILE if unset
# (the same EVM key works on both chains). Override only if you want a different signer
# on Base than on Avalanche.
# export DEGENPRIME_PRIVATE_KEY="0x..."
# export DEGENPRIME_KEY_FILE="/path/to/.degenprime-key"
# export DEGENPRIME_RPC="https://base-mainnet.g.alchemy.com/v2/YOUR-KEY"
